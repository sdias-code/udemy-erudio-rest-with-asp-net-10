{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "RestWithAspNet10_Scaffold": "Debug"
    }
  },

  "AllowedHosts": "*",

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.MSSqlServer"
    ],
    "MinimumLevel": "Information",

    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "SqlServerConnection",
          "tableName": "Logs",
          "autoCreateSqlTable": false
        }
      }
    ]
  },

  "ConnectionStrings": {
    "SqlServerConnection": "Server=localhost,1433;Database=db_erudio;User Id=sa;Password=Admin@123456;TrustServerCertificate=True;"  
  },

  "Cors": {
    "Origins": [
      "http://localhost:5000",
      "https://localhost:5001",
      "https://sdiascode.com.br",
      "https://localhost:8443"
    ]
  },
  "TokenConfiguration": {
    "Audience": "ExampleAudience",
    "Issuer": "ExampleIssuer",
    "Minutes": 60,
    "DaysToExpiry": 7
  },  
  "EmailSettings": {
    "Subject": "Default Subject",
    "Message": "Default Message",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "${EMAIL_USERNAME}",
    "Password": "${EMAIL_PASSWORD}",
    "Properties": {
      "SmtpAuth": "true",
      "StartTlsEnable": "true"
    },
    "Ssl": true
  }
}